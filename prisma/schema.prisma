generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Commodity {
  id              Int              @id
  name            String
  code            String
  kind            String?
  weightScu       Float?
  isBuyable       Boolean          @default(false)
  isSellable      Boolean          @default(false)
  isIllegal       Boolean          @default(false)
  isRaw           Boolean          @default(false)
  isRefined       Boolean          @default(false)
  dateAdded       Int?
  dateModified    Int?
  priceSnapshots  PriceSnapshot[]
}

model Terminal {
  id                 Int              @id
  name               String
  code               String?
  type               String?
  starSystemName     String?
  planetName         String?
  moonName           String?
  cityName           String?
  spaceStationName   String?
  hasCargoCenter     Boolean          @default(false)
  hasDockingPort     Boolean          @default(false)
  hasFreightElevator Boolean          @default(false)
  isAutoLoad         Boolean          @default(false)
  priceSnapshots     PriceSnapshot[]
}

model PriceSnapshot {
  id           Int        @id @default(autoincrement())
  commodityId  Int
  terminalId   Int
  priceBuy     Float?
  priceSell    Float?
  scuBuyStock  Int?
  scuSellStock Int?
  uexModifiedAt Int?
  fetchedAt    DateTime

  commodity    Commodity  @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  terminal     Terminal   @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([commodityId, terminalId, fetchedAt])
  @@index([fetchedAt])
}
